---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteViewer from '../../components/SiteViewer.astro';
import DeckViewer from '../../components/DeckViewer.astro';
import { formatMonth, getProjects, roman } from '../../lib/projects';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, next: projects[(i + 1) % projects.length] },
	}));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const sections = headings.filter((h) => h.depth === 2);

// Lead media: the live site itself (embed), else a deck, else the motion preview, else the image.
const embed = data.embedPages && data.liveUrl ? data.embedPages : null;
const deck = data.deck ?? null;
const video = !embed && !deck && data.heroVideo ? `/media/${data.heroVideo}` : null;
const poster = video ? await getImage({ src: data.hero, width: 2008, format: 'webp' }) : null;
const pageUrl = (path: string) => new URL(path, data.liveUrl).href;

// Left-column Contents: numbered from I. whatever the source. Hidden slides stay in the deck.
type Entry = { label: string; href?: string; slide?: number };
const contents: Entry[] = embed
	? embed.map((pg) => ({ label: pg.label, href: pageUrl(pg.path) }))
	: deck
		? deck.slides
				.map((label, slide) => ({ label, slide }))
				.filter(({ label }) => !deck.hideFromList.includes(label))
		: sections.map((h) => ({ label: h.text, href: `#${h.slug}` }));

const spec = [
	{ label: 'Skills', value: data.skills },
	{ label: 'Tools', value: data.tools.join(', ') },
	{ label: 'Date', value: formatMonth(data.date) },
].filter((s) => s.value);

// "← Selected works / Next" — in the rail on desktop, and again at the end of the write-up.
const more = [
	{ href: '/', label: '← Selected works' },
	{ href: `/projects/${next.id}/`, label: `Next: ${next.data.title} →` },
];
---

<Base title={data.title} description={data.description} image={data.hero}>
	{embed && <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" />}
	<!--
		Same frame as the home page: the title sits at the top of the left rail, level
		with the spec strip opposite, and stays in view (sticky) while the case study scrolls.
	-->
	<div class="page split pt-8 pb-10 lg:pt-10">
		<aside class="left sticky-col flex flex-col gap-10 lg:gap-12" aria-label="On this page">
			<h1 class="t-rail-title text-balance">{data.title}</h1>

			<!-- One Contents menu for every project: sections of the write-up, slides of the
			     deck, or pages of the embedded site. On phones it folds up, so the work comes first. -->
			<details class="contents-fold" open>
				<summary class="block border-t border-ink pt-2 lg:pointer-events-none">
					<h2 class="t-section">Contents</h2>
				</summary>
				<ol class="mt-4 flex flex-col gap-2" id={embed ? 'site-pages' : deck ? 'deck-slides' : 'contents'}>
					{contents.map((item, i) => {
						// Slides are buttons (they drive the deck); everything else is a link.
						const Tag = item.slide !== undefined ? 'button' : 'a';
						const attrs =
							item.slide !== undefined
								? { type: 'button', 'data-slide': item.slide }
								: { href: item.href, target: embed ? 'site-viewer' : undefined, 'aria-current': embed && i === 0 ? 'true' : undefined };
						return (
							<li>
								<Tag {...attrs} class="toc-item t-small flex cursor-pointer gap-2 text-left text-ink-soft hover:text-ink">
									<span class="w-8 flex-none text-ink-faint">{roman(i + 1)}</span>
									<span class="label">{item.label}</span>
								</Tag>
							</li>
						);
					})}
				</ol>
			</details>
			<script is:inline>
				// Runs as the page parses, so phones never see the list open and then jump shut.
				// On desktop it's a plain label, so keep it open even from the keyboard.
				(() => {
					const fold = document.currentScript.previousElementSibling;
					const desktop = matchMedia('(min-width: 64rem)');
					if (!desktop.matches) fold.open = false;
					fold.addEventListener('toggle', () => desktop.matches && !fold.open && (fold.open = true));
				})();
			</script>

			<!-- Desktop only: on phones the same links close the write-up instead. -->
			<div class="hidden flex-col items-start gap-2 lg:flex">
				{more.map((l) => <a href={l.href} class="t-small hover:underline underline-offset-3">{l.label}</a>)}
			</div>
		</aside>

		<article class="main">
			<dl class="grid gap-4 border-t border-rule pt-2 sm:grid-cols-3">
				{
					spec.map(({ label, value }) => (
						<div class="flex flex-col gap-1">
							<dt class="t-caption text-ink-faint">{label}</dt>
							<dd class="t-small">{value}</dd>
						</div>
					))
				}
			</dl>

			{
				(data.liveUrl || data.repoUrl) && (
					<ul class="mt-6 flex gap-6">
						{data.liveUrl && (
							<li>
								<a href={data.liveUrl} target="_blank" rel="noopener" class="action">
									View live<span class="ext" aria-hidden="true">↗</span>
								</a>
							</li>
						)}
						{data.repoUrl && (
							<li>
								<a href={data.repoUrl} target="_blank" rel="noopener" class="action">
									Explore repo<span class="ext" aria-hidden="true">↗</span>
								</a>
							</li>
						)}
					</ul>
				)
			}

			<div class="mt-12">
				{
					embed ? (
						<SiteViewer src={data.liveUrl!} title={data.title} />
					) : deck ? (
						<DeckViewer dir={deck.dir} slides={deck.slides} motion={deck.motion} />
					) : (
						<a href={data.liveUrl} target="_blank" rel="noopener" class="block" aria-label={`Open ${data.title} in a new tab`}>
							{video ? (
								<video
									class="lead-video media-edge w-full"
									src={video}
									poster={poster!.src}
									width={poster!.attributes.width}
									height={poster!.attributes.height}
									muted
									loop
									playsinline
									preload="metadata"
									data-autoplay
									aria-label={data.heroAlt}
								/>
							) : (
								<Image src={data.hero} alt={data.heroAlt} widths={[1004, 2008]} sizes="(min-width: 1440px) 1004px, 100vw" class="media-edge w-full" />
							)}
						</a>
					)
				}
			</div>

			<div class="case-body mt-16 lg:mt-20">
				<Content />
			</div>

			<!-- End of the write-up: where to go next. -->
			<nav class="flex flex-wrap justify-between gap-4 border-t border-ink pt-2" aria-label="More work">
				{more.map((l) => <a href={l.href} class="t-small hover:underline underline-offset-3">{l.label}</a>)}
			</nav>
		</article>
	</div>
</Base>

<style>
	.toc-item[aria-current='true'] {
		color: var(--color-ink);
	}
	.toc-item[aria-current='true'] .label {
		font-weight: 500;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* Contents: a plain label on desktop; a tap-to-open fold on phones, marked + / −. */
	.contents-fold summary {
		list-style: none;
	}
	.contents-fold summary::-webkit-details-marker {
		display: none;
	}
	@media (max-width: 63.99rem) {
		.contents-fold summary {
			display: flex;
			justify-content: space-between;
			cursor: pointer;
		}
		.contents-fold summary::after {
			content: '+';
			font-family: var(--font-mono);
			font-size: 12px;
			line-height: 14px;
		}
		.contents-fold[open] summary::after {
			content: '−';
		}
	}
</style>

<script>
	// Scroll-spy: mark the section currently in view as active in Contents.
	const links = [...document.querySelectorAll<HTMLAnchorElement>('#contents a')];
	const targets = links
		.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))?.closest('section'))
		.filter((s): s is HTMLElement => !!s);

	function update() {
		const line = window.innerHeight * 0.3;
		let active = 0;
		targets.forEach((s, i) => {
			if (s.getBoundingClientRect().top <= line) active = i;
		});
		links.forEach((a, i) => (i === active ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
	}

	if (targets.length) {
		update();
		window.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
	}
</script>
