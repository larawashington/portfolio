---
import '../styles/global.css';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
	title?: string;
	description?: string;
	/** Which top-nav item to mark as current. */
	current?: 'Work' | 'About';
}

const { title, description = site.intro, current } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.title;
const year = new Date().getFullYear();
const href = (h: string) => (h.startsWith('/') ? url(h) : h);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
		<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=Saira:wght@300;400;500&display=swap"
		/>
		<slot name="head" />
	</head>
	<body>
		<header class="page" id="top">
			<div class="header-bar flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 border-b border-ink py-6 lg:py-12 lg:pb-4">
				<a href={url('/')} class="t-wordmark whitespace-nowrap">
					<svg class="mr-1.5 inline-block size-[1.1em] align-[-0.2em] text-vert-profond" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
						<path
							fill="currentColor"
							d="M16 1C16.81 14.21 17.79 15.19 31 16C17.79 16.81 16.81 17.79 16 31C15.19 17.79 14.21 16.81 1 16C14.21 15.19 15.19 14.21 16 1Z"
						/>
					</svg>
					{site.name}
				</a>
				<nav aria-label="Primary">
					<ul class="flex gap-2.5 sm:gap-5 lg:gap-8">
						{
							site.nav.map((item) =>
								item.menu ? (
									<li class="contact-menu">
										<button type="button" class="t-small whitespace-nowrap" aria-haspopup="true" aria-expanded="false">
											{item.label}
										</button>
										<div class="menu">
											<ul>
												{site.contact.map(({ label, href: h, internal }) => {
													const isMail = h.startsWith('mailto:');
													return (
														<li>
															<a
																href={internal ? url(h) : h}
																target={isMail ? undefined : '_blank'}
																rel={isMail ? undefined : 'noopener'}
																class="t-small flex items-baseline justify-between gap-6 py-2 text-ink-soft transition-colors hover:text-ink"
															>
																<span>{label}</span>
																<span class="text-ink-faint" aria-hidden="true">→</span>
															</a>
														</li>
													);
												})}
											</ul>
										</div>
									</li>
								) : (
									<li>
										<a
											href={href(item.href)}
											class:list={[
												't-small whitespace-nowrap hover:underline underline-offset-3',
												current === item.label && 'font-medium underline',
											]}
											aria-current={current === item.label ? 'page' : undefined}
										>
											{item.label}
										</a>
									</li>
								),
							)
						}
					</ul>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="page" id="contact">
			<div class="border-t border-ink pt-4 pb-12 split items-baseline">
				<p class="left t-caption text-ink-soft">© {year} {site.name}</p>
				<div class="main flex flex-wrap items-baseline justify-between gap-x-10 gap-y-6">
					<ul class="flex flex-wrap gap-x-10 gap-y-4">
						{
							site.contact.map(({ label, href: h, internal }) => {
								const isMail = h.startsWith('mailto:');
								return (
									<li>
										<a
											href={internal ? url(h) : h}
											target={isMail ? undefined : '_blank'}
											rel={isMail ? undefined : 'noopener'}
											class="t-small block font-medium hover:underline underline-offset-3"
										>
											{label}
											<span class="ext" aria-hidden="true">↗</span>
										</a>
									</li>
								);
							})
						}
					</ul>
					<a href="#top" class="t-small font-medium hover:underline underline-offset-3">
						Back to top <span class="ext" aria-hidden="true">↑</span>
					</a>
				</div>
			</div>
		</footer>
		<script>
			// Contact menu: opens on hover/focus (CSS). Touch screens have no hover, so a tap toggles it there.
			const menu = document.querySelector<HTMLElement>('.contact-menu');
			if (menu) {
				const button = menu.querySelector('button')!;
				const set = (open: boolean) => {
					menu.toggleAttribute('data-open', open);
					button.setAttribute('aria-expanded', String(open));
				};
				// Mouse: hover only, clicking Contact does nothing.
				menu.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && set(true));
				menu.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && set(false));
				// Touch/pen: a tap toggles; a tap anywhere else closes.
				button.addEventListener('pointerup', (e) => e.pointerType !== 'mouse' && set(!menu.hasAttribute('data-open')));
				document.addEventListener('pointerdown', (e) => {
					if (e.pointerType !== 'mouse' && !menu.contains(e.target as Node)) set(false);
				});
				menu.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') {
						set(false);
						button.focus();
					}
				});
			}
		</script>
	</body>
</html>
