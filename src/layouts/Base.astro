---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	/** Which top-nav item to mark as current. */
	current?: 'Work' | 'About';
	/** Link-preview image (LinkedIn, Slack…). Built here at the size they expect. */
	image?: ImageMetadata;
}

const { title, description = site.intro, current, image } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = image && new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, Astro.site);
const year = new Date().getFullYear();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={'/favicon.ico'} sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href={'/favicon.svg'} />
		<link rel="apple-touch-icon" href={'/apple-touch-icon.png'} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href={'/sitemap-index.xml'} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{shareImage && <meta property="og:image" content={shareImage} />}
		<meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=Saira:wght@300;400;500&display=swap"
		/>
		<slot name="head" />
	</head>
	<body>
		<header class="page" id="top">
			<div class="header-bar flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 border-b border-ink py-6 lg:py-12 lg:pb-4">
				<a href={'/'} class="t-wordmark whitespace-nowrap">
					<svg class="mr-1.5 inline-block size-[1.1em] align-[-0.2em] text-vert-profond" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
						<path
							fill="currentColor"
							d="M16 1C16.81 14.21 17.79 15.19 31 16C17.79 16.81 16.81 17.79 16 31C15.19 17.79 14.21 16.81 1 16C14.21 15.19 15.19 14.21 16 1Z"
						/>
					</svg>
					{site.name}
				</a>
				<nav aria-label="Primary">
					<ul class="flex gap-2.5 sm:gap-5 lg:gap-8">
						{
							site.nav.map((item) =>
								item.menu ? (
									<li class="contact-menu">
										<button type="button" class="t-small whitespace-nowrap" aria-haspopup="true" aria-expanded="false">
											{item.label}
										</button>
										<div class="menu">
											<ul>
												{site.contact.map(({ label, href: h }) => {
													const isMail = h.startsWith('mailto:');
													return (
														<li>
															<a
																href={h}
																target={isMail ? undefined : '_blank'}
																rel={isMail ? undefined : 'noopener'}
																class="t-small flex items-baseline justify-between gap-6 py-2 text-ink-soft transition-colors hover:text-ink"
															>
																<span data-label>{label}</span>
																<span class="text-ink-faint" aria-hidden="true">→</span>
															</a>
														</li>
													);
												})}
											</ul>
										</div>
									</li>
								) : (
									<li>
										<a
											href={item.href}
											class:list={[
												't-small whitespace-nowrap hover:underline underline-offset-3',
												current === item.label && 'font-medium underline',
											]}
											aria-current={current === item.label ? 'page' : undefined}
										>
											{item.label}
										</a>
									</li>
								),
							)
						}
					</ul>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="page" id="contact">
			<div class="border-t border-ink pt-4 pb-12 split items-baseline">
				<p class="left t-caption text-ink-soft">© {year} {site.name}</p>
				<div class="main flex flex-wrap items-baseline justify-between gap-x-10 gap-y-6">
					<ul class="flex flex-wrap gap-x-10 gap-y-4">
						{
							site.contact.map(({ label, href: h }) => {
								const isMail = h.startsWith('mailto:');
								return (
									<li>
										<a
											href={h}
											target={isMail ? undefined : '_blank'}
											rel={isMail ? undefined : 'noopener'}
											class="t-small block font-medium hover:underline underline-offset-3"
										>
											<span data-label>{label}</span>
											<span class="ext" aria-hidden="true">↗</span>
										</a>
									</li>
								);
							})
						}
					</ul>
					<a href="#top" class="t-small font-medium hover:underline underline-offset-3">
						Back to top <span class="ext" aria-hidden="true">↑</span>
					</a>
				</div>
			</div>
		</footer>
		<script>
			// Looping videos marked data-autoplay (lead videos, write-up recordings) play only while
			// on screen, so nothing downloads until it's needed. With reduced motion they stay
			// still and get controls instead.
			const loops = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
				loops.forEach((v) => (v.controls = true));
			} else if (loops.length) {
				const io = new IntersectionObserver((entries) =>
					entries.forEach(({ target, isIntersecting }) => {
						const v = target as HTMLVideoElement;
						if (isIntersecting) v.play().catch(() => {});
						else v.pause();
					}),
				);
				loops.forEach((v) => io.observe(v));
			}
		</script>
		<script>
			// Contact menu: opens on hover/focus (CSS). Touch screens have no hover, so a tap toggles it there.
			const menu = document.querySelector<HTMLElement>('.contact-menu');
			if (menu) {
				const button = menu.querySelector('button')!;
				const set = (open: boolean) => {
					menu.toggleAttribute('data-open', open);
					button.setAttribute('aria-expanded', String(open));
				};
				// Mouse: hover only, clicking Contact does nothing.
				menu.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && set(true));
				menu.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && set(false));
				// Touch/pen: a tap toggles; a tap anywhere else closes.
				button.addEventListener('pointerup', (e) => e.pointerType !== 'mouse' && set(!menu.hasAttribute('data-open')));
				document.addEventListener('pointerdown', (e) => {
					if (e.pointerType !== 'mouse' && !menu.contains(e.target as Node)) set(false);
				});
				menu.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') {
						set(false);
						button.focus();
					}
				});
			}
		</script>
		<p class="sr-only" aria-live="polite" id="copy-status"></p>
		<script>
			// Email links: mailto does nothing when no mail app is set up, so a click also copies
			// the address and the label briefly reads "Copied". The mailto still opens a mail app if there is one.
			const status = document.getElementById('copy-status')!;
			document.addEventListener('click', (e) => {
				const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="mailto:"]');
				if (!a) return;
				const address = a.href.slice('mailto:'.length).split('?')[0];
				navigator.clipboard?.writeText(address).then(() => {
					const label = a.querySelector<HTMLElement>('[data-label]');
					if (label) {
						const text = label.dataset.text ?? label.textContent ?? '';
						label.dataset.text = text;
						label.textContent = 'Copied';
						clearTimeout(Number(label.dataset.timer));
						label.dataset.timer = String(setTimeout(() => (label.textContent = text), 1600));
					}
					status.textContent = `Email address ${address} copied`;
				}, () => {});
			});
		</script>
	</body>
</html>
